#!/bin/sh

STAGED=$(git diff --cached --name-only --diff-filter=d)
if [ -n "$STAGED" ]; then
  echo "$STAGED" | xargs npx prettier --write --ignore-unknown || exit 1
fi
git add -u

script_dir=$(dirname "$0")/..
. "$script_dir/scripts/parallel-exit-on-failure.sh"

echo "  Running checks..."

# e2e tests are Linux-only in CI (pr.yml: windows job runs test:unit only)
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*) TEST_CMD="npm run test:unit" ;;
  *)                    TEST_CMD="npm test" ;;
esac

# Static checks run in parallel; the test suite runs on its own afterwards.
# Running tests alongside the other checks starves CPU on Windows and makes
# slow tests (e.g. init-llm) time out under load.
parallel_exit_on_failure \
  "lint"      "npm run lint" \
  "typecheck" "npm run typecheck" \
  "format"    "npm run format" \
  "duplicate" "npm run duplicate" \
  || exit 1

echo "  Running tests..."
sh -c "$TEST_CMD" || exit 1
